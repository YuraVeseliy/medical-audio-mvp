{
  "segments": [
    {
      "start": 0.0,
      "end": 1.44,
      "text": " Что вас беспокоит?"
    },
    {
      "start": 1.44,
      "end": 4.8,
      "text": " У меня сухой кашел, когда он появился."
    },
    {
      "start": 4.8,
      "end": 7.24,
      "text": " Кашел на часа три дня назад."
    },
    {
      "start": 7.24,
      "end": 9.16,
      "text": " Было ли подобное раньше?"
    },
    {
      "start": 9.16,
      "end": 11.84,
      "text": " В прошлом году уже был похожий кашел."
    },
    {
      "start": 11.84,
      "end": 13.2,
      "text": " Что вы принимали?"
    },
    {
      "start": 13.2,
      "end": 15.32,
      "text": " Сегодня утром выпил теплый чай."
    }
