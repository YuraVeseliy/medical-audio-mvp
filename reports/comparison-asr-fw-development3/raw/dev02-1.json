{
  "segments": [
    {
      "start": 0.0,
      "end": 1.92,
      "text": " Какие сейчас жалобы?"
    },
    {
      "start": 1.92,
      "end": 6.16,
      "text": " Болит голова в области висков, когда началось бол."
    },
    {
      "start": 6.16,
      "end": 8.76,
      "text": " Голова заболела сегодня после обеда."
    },
    {
      "start": 8.76,
      "end": 10.36,
      "text": " Боль постоянная."
    },
    {
      "start": 10.36,
      "end": 12.84,
      "text": " Боль усиливается при ярком свете."
    },
    {
      "start": 12.84,
      "end": 15.52,
      "text": " Бывали такие приступы раньше."
    },
    {
      "start": 15.52,
      "end": 18.0,
      "text": " Раньше подобных приступов не было."
    }
  ],
  "language": "ru",
