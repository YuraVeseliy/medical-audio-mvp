{
  "segments": [
    {
      "start": 0.0,
      "end": 1.96,
      "text": " Что мешает вам сейчас?"
    },
    {
      "start": 1.96,
      "end": 4.8,
      "text": " Не хватает воздуха при подъеме по лестнице."
    },
    {
      "start": 4.8,
      "end": 8.16,
      "text": " Покое это бывает, в покое дышу свободно."
    },
    {
      "start": 8.16,
      "end": 11.48,
      "text": " Когда заметили эту жалобу, а дышку заметил около"
    },
    {
      "start": 11.48,
      "end": 13.04,
      "text": " двух недел назад."
    },
    {
      "start": 13.04,
      "end": 15.08,
      "text": " Какие заболевания были раньше?"
    },
    {
      "start": 15.08,
      "end": 17.84,
      "text": " В детстве несколько раз переносил бронхит."
    }
  ],
  "language": "ru",
