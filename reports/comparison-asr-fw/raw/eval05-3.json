{
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": " Какие жалобы сегодня?"
    },
    {
      "start": 2.0,
      "end": 4.24,
      "text": " Заложен нос с обеих сторон."
    },
    {
      "start": 4.24,
      "end": 5.84,
      "text": " Есть боль в горле."
    },
    {
      "start": 5.84,
      "end": 7.6,
      "text": " Горла не болит."
    },
    {
      "start": 7.6,
      "end": 12.16,
      "text": " Когда началась заложенность, нос заложила позавчераутом."
    },
    {
      "start": 12.16,
      "end": 15.16,
      "text": " Бывали подобные состояния раньше."
    },
    {
      "start": 15.16,
      "end": 17.72,
      "text": " Каждую весну несколько дней беспокоит нас, Марк."
    }
  ],
  "language": "ru",
  "language_probability": 1
}