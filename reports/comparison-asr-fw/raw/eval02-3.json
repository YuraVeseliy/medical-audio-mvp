{
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": " Что вас беспокоит сейчас?"
    },
    {
      "start": 2.0,
      "end": 4.2,
      "text": " Тянет живот около пупка."
    },
    {
      "start": 4.2,
      "end": 5.7,
      "text": " Есть тошнота."
    },
    {
      "start": 5.7,
      "end": 7.2,
      "text": " Ташноты нет."
    },
    {
      "start": 7.2,
      "end": 9.92,
      "text": " Когда начались неприятные ощущения."
    },
    {
      "start": 9.92,
      "end": 12.08,
      "text": " Живот начал болеть ночью."
    },
    {
      "start": 12.08,
      "end": 14.04,
      "text": " Такое уже случалось."
    },
    {
      "start": 14.04,
      "end": 16.08,
      "text": " Похожая боль была месяц назад."
    }
  ],
  "language": "ru",
  "language_probability": 1
}