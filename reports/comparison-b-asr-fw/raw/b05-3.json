{
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": " Какая жалоба сейчас?"
    },
    {
      "start": 2.0,
      "end": 3.72,
      "text": " Правая кисть анимела."
    },
    {
      "start": 3.72,
      "end": 5.4,
      "text": " Кто ощущаете в пальцах?"
    },
    {
      "start": 5.4,
      "end": 8.0,
      "text": " Пальция на правой руке холодная."
    },
    {
      "start": 8.0,
      "end": 12.16,
      "text": " Когда заметили анимение, анимение заметил после сна."
    },
    {
      "start": 12.16,
      "end": 13.96,
      "text": " Такое бывало раньше."
    },
    {
      "start": 13.96,
      "end": 15.52,
      "text": " Такое случилось впервые."
    }
  ],
  "language": "ru",
  "language_probability": 1
}