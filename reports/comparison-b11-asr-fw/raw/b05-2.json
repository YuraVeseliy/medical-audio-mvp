{
  "segments": [
    {
      "start": 0.0,
      "end": 2.0,
      "text": " Какая жалоба сейчас?"
    },
    {
      "start": 2.0,
      "end": 3.8,
      "text": " Правая кисть анимела."
    },
    {
      "start": 3.8,
      "end": 5.52,
      "text": " Кто ощущаете в пальцах?"
    },
    {
      "start": 5.52,
      "end": 7.92,
      "text": " Пальцы на правой руке холодные."
    },
    {
      "start": 7.92,
      "end": 11.08,
      "text": " Когда заметили анимение, анимение заметил после"
    },
    {
      "start": 11.08,
      "end": 12.08,
      "text": " сна."
    },
    {
      "start": 12.08,
      "end": 13.68,
      "text": " Такое бывало раньше."
    },
    {
      "start": 13.68,
      "end": 15.36,
      "text": " Такое случилось впервые."
    }
  ],
  "language": "ru",
  "language_probability": 1
}